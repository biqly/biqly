## Core Types Reference

### LogicalQuery (`internal/query/logical.go`)

```go
type LogicalQuery struct {
    Version      string       `json:"version,omitempty"`      // schema version (v1)
    DatasourceID string       `json:"datasource_id"`
    ModelID      string       `json:"model_id"`
    Select       []SelectItem `json:"select"`
    Filters      []Filter     `json:"filters,omitempty"`
    GroupBy      []GroupBy    `json:"group_by,omitempty"`
    Having       []Filter     `json:"having,omitempty"`       // post-aggregation filters
    OrderBy      []OrderBy    `json:"order_by,omitempty"`
    Limit        int          `json:"limit"`
    Offset       int          `json:"offset,omitempty"`
    CTEs         []CTE        `json:"ctes,omitempty"`         // WITH ... AS clauses
}

type SelectItem struct {
    Type   string      `json:"type"`              // dimension | metric | window
    Name   string      `json:"name"`
    Alias  string      `json:"alias,omitempty"`
    Window *WindowSpec  `json:"window,omitempty"`  // only when Type == "window"
}

type WindowSpec struct {
    Aggregation string    `json:"aggregation"`
    Expression  string    `json:"expression,omitempty"`
    Metric      string    `json:"metric,omitempty"`
    PartitionBy []string  `json:"partition_by,omitempty"`
    OrderBy     []OrderBy `json:"order_by,omitempty"`
    Frame       string    `json:"frame,omitempty"`
}

type Filter struct {
    Field    string `json:"field"`
    Operator string `json:"operator"`
    Value    any    `json:"value"`
}

type GroupBy struct {
    Field     string `json:"field"`
    TimeGrain string `json:"time_grain,omitempty"` // day|week|month|quarter|year
}

type OrderBy struct {
    Field     string `json:"field"`
    Direction string `json:"direction"` // asc|desc
}
```

**Operators**: `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in`, `not_in`, `contains`, `starts_with`, `ends_with`, `between`, `is_null`, `is_not_null`

**TimeGrain**: `day`, `week`, `month`, `quarter`, `year`

### SemanticModel (`internal/semantic/model.go`)

```go
type SemanticModel struct {
    ID             string      `json:"id"`
    DatasourceID   string      `json:"datasource_id"`
    Name           string      `json:"name"`
    Label          *string     `json:"label"`
    Description    *string     `json:"description"`
    BaseSchema     string      `json:"base_schema"`
    BaseTable      string      `json:"base_table"`
    Synonyms       []string    `json:"synonyms"`
    IsActive       bool        `json:"is_active"`
    Status         string      `json:"status"`       // draft | published
    Version        int         `json:"version"`
    Dimensions     []Dimension `json:"dimensions"`
    Metrics        []Metric    `json:"metrics"`
    Joins          []Join      `json:"joins"`
}

type Dimension struct {
    Name                 string   `json:"name"`
    ColumnRef            string   `json:"column_ref"`
    Type                 string   `json:"type"`        // text|number|date|boolean|geo
    Synonyms             []string `json:"synonyms"`
    IsDisplay            bool     `json:"is_display"`  // preferred for readable labels
    CalculatedExpression string   `json:"calculated_expression,omitempty"`
}

type Metric struct {
    Name        string   `json:"name"`
    Expression  string   `json:"expression"`   // e.g. "orders.total_amount"
    Aggregation string   `json:"aggregation"`  // count|sum|avg|min|max|count_distinct
    Format      *string  `json:"format"`
    Synonyms    []string `json:"synonyms"`
}

type Join struct {
    Name         string `json:"name"`
    FromTable    string `json:"from_table"`
    FromColumn   string `json:"from_column"`
    ToTable      string `json:"to_table"`
    ToColumn     string `json:"to_column"`
    JoinType     string `json:"join_type"`       // LEFT|INNER|RIGHT
    Relationship string `json:"relationship"`    // many_to_one|one_to_many|one_to_one|many_to_many
}
```

### Driver Interface (`internal/datasource/datasource.go`)

```go
type Driver interface {
    Type() string
    Ping(ctx context.Context, dsn string) error
    Open(ctx context.Context, dsn string) (*sql.DB, error)
    Introspect(ctx context.Context, db *sql.DB) (*IntrospectionResult, error)
    Dialect() dialect.Dialect
}
```

### Dialect Interface (`internal/dialect/dialect.go`)

```go
type Dialect interface {
    Name() string
    QuoteIdent(identifier string) string
    QuoteIdentSegment(identifier string) string
    Placeholder(index int) string
    LimitOffset(limit, offset int) string
    DateTrunc(part, column string) string
    CalendarPart(part, column string) string
    ILike(column, placeholder string) string
    CastType(sqlType string) string
    Aggregate(fn, column string) string
    ExplainSQL(sql string) string
}
```

