{
  "mcpServers": {
    "pgedge-biqly": {
      "command": "/Users/YOU/.local/bin/biqly-pgedge-mcp",
      "env": {
        "PGHOST": "127.0.0.1",
        "PGPORT": "5432",
        "PGDATABASE": "bi_metadata",
        "PGUSER": "biqly",
        "PGPASSWORD": "REPLACE_WITH_BIQLY_DB_PASSWORD",
        "PGSSLMODE": "disable"
      }
    }
  }
}
