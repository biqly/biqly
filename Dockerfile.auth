FROM golang:1.26-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /auth ./cmd/auth/
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /auth-migrate ./cmd/auth-migrate/

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /auth /auth
COPY --from=builder /auth-migrate /auth-migrate
COPY migrations/auth /migrations/auth
EXPOSE 8889
ENTRYPOINT ["/auth"]
