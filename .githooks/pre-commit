#!/bin/sh
# Pre-commit hook: format → stage → Go gate → frontend CI gate.
#
# Mirrors the gates CI enforces, so CI failures surface locally first:
#   1. Format all files (Prettier for frontend, gofmt for Go via lint) and stage them
#   2. Go:       lint-go + test-go
#   3. Frontend: check-frontend = the exact `npm run check` CI runs
#                (lint + tailwind + format:check + knip + test + build/tsc --noEmit)
#   4. Block the commit if anything fails
#
# The frontend build step runs `tsc --noEmit`, which catches the type errors that
# previously only failed in CI. Frontend lint/test live inside check-frontend, so
# we run lint-go/test-go here (not the combined lint/test) to avoid a double run.
#
# Activated by: git config core.hooksPath .githooks
# (or run: make setup-githooks)

set -e

echo "=== pre-commit: formatting ==="
make format-frontend
git add -u

echo "=== pre-commit: Go lint + tests ==="
make lint-go
make test-go

echo "=== pre-commit: frontend CI gate (lint, tailwind, format:check, knip, test, build/tsc) ==="
make check-frontend

echo "=== pre-commit: all checks passed ==="
