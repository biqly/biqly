# Host-native development overrides — copy to .env.dev (gitignored):
#     cp .env.dev.example .env.dev
#
# When you run the Go services on the HOST (make watch / debug-watch / dev /
# run / debug) against the Dockerized infra from `make dev-up`, the DSN hosts
# must be `localhost` (the published compose ports), not the in-cluster service
# names (postgres, redis, nats) that .env carries for `make docker-up`.
#
# All three biqly system databases live in ONE Postgres container on
# localhost:5432 (bi_metadata + bi_auth + bi_mail), mirroring Kubernetes.
# These targets source .env first, then .env.dev (if present), so .env.dev only
# overrides host:port. Credentials match docker-compose.yml (already public
# there) — no real secrets live here.

# Shared Postgres (bi_metadata / bi_auth / bi_mail) -> localhost:5432
BI_METADATA_DB_DSN=postgres://bi_user:bi_password@localhost:5432/bi_metadata?sslmode=disable
BI_AUTH_DB_DSN=postgres://bi_user:bi_password@localhost:5432/bi_auth?sslmode=disable
BI_MAIL_DB_DSN=postgres://bi_user:bi_password@localhost:5432/bi_mail?sslmode=disable

# redis (dragonfly) -> localhost:6379
BI_REDIS_DSN=redis://localhost:6379
BI_AUTH_REDIS_DSN=redis://localhost:6379
BI_MAIL_REDIS_DSN=redis://localhost:6379

# nats -> localhost:4222
BI_NATS_URL=nats://localhost:4222

# Inter-service URLs — host-native, services reach each other on localhost.
# api proxies /api/auth/* to auth; without this you get
# "Unable to initialize CSRF token" on the sign-in page.
BI_AUTH_SERVICE_URL=http://localhost:8889
# auth -> mail (verification / reset emails)
BI_AUTH_MAIL_SERVICE_URL=http://localhost:8890

# test-datasource — external customer DB for introspection tests -> localhost:5433
BI_TEST_DB_DSN=postgres://test_user:test_password@localhost:5433/test_data?sslmode=disable
