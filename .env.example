# BI Query Engine Environment Variables
# Copy to .env and modify as needed

# HTTP Server
BI_HTTP_HOST=0.0.0.0
BI_HTTP_PORT=8888

# Metadata Database (PostgreSQL)
BI_METADATA_DB_DSN=postgres://bi_user:bi_password@localhost:5432/bi_metadata?sslmode=disable

# Redis (for caching)
BI_REDIS_DSN=redis://localhost:6379

# Query Settings
BI_QUERY_TIMEOUT_SECONDS=30
BI_QUERY_MAX_ROWS=10000
BI_QUERY_MAX_RUNTIME_SECONDS=60

# Security - 32-byte key for credential encryption
BI_ENCRYPTION_KEY=change-this-to-a-secure-32-byte-key!!

# AI Provider (OpenAI compatible)
BI_AI_PROVIDER=openai
BI_AI_API_KEY=
BI_AI_BASE_URL=
BI_AI_MODEL=gpt-4o
BI_AI_MAX_TOKENS=4096
BI_AI_TEMPERATURE=0.0
BI_AI_TOP_P=
BI_AI_NUM_CTX=
BI_AI_HTTP_TIMEOUT_SECONDS=300
BI_AI_RATE_LIMIT_PER_MINUTE=20
# Cap NL→query prompt size (runes ≈ characters for Latin text; lower if provider returns context-length errors)
BI_AI_MAX_PROMPT_RUNES=80000
# AI Describe: truncate each sampled cell; max rows sent to the LLM
BI_AI_DESCRIBE_MAX_CELL_RUNES=500
BI_AI_DESCRIBE_MAX_SAMPLE_ROWS=12
# Vector embeddings for table routing (optional). Leave BI_AI_EMBEDDING_MODEL
# empty to disable embeddings (keyword-only routing). When set, use
# BI_AI_EMBEDDING_BASE_URL / BI_AI_EMBEDDING_API_KEY for a different host than
# the chat model; if unset, embeddings fall back to BI_AI_BASE_URL / BI_AI_API_KEY.
#BI_AI_EMBEDDING_MODEL=text-embedding-3-small
#BI_AI_EMBEDDING_BASE_URL=
#BI_AI_EMBEDDING_API_KEY=
BI_AI_EMBEDDING_WEIGHT=30
# Self-consistency voting (>1 draws N candidates with stepped temperatures).
BI_AI_MULTI_CANDIDATE_COUNT=1
