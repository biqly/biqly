# BI Query Engine Environment Variables
# Copy to .env and modify as needed

# HTTP Server
BI_HTTP_HOST=0.0.0.0
BI_HTTP_PORT=8888

# Metadata Database (PostgreSQL)
BI_METADATA_DB_DSN=postgres://bi_user:bi_password@localhost:5432/bi_metadata?sslmode=disable

# Redis (for caching)
BI_REDIS_DSN=redis://localhost:6379

# Optional local test SQL Server (docker compose: test-sqlserver = Azure SQL Edge, port 1433)
# sqlserver-init loads scripts/sql-server-sample-database (BikeStores) automatically.
# BI_TEST_SQLSERVER_DSN=sqlserver://test_user:Test_password123!@localhost:1433?database=test_data&encrypt=disable
# BI_TEST_SQLSERVER_BIKESTORES_DSN=sqlserver://test_user:Test_password123!@localhost:1433?database=BikeStores&encrypt=disable
# Full SQL Server 2022 (linux/amd64): docker compose --profile sqlserver-2022 up -d
#   DSN host port 1434: sqlserver://test_user:Test_password123!@localhost:1434?database=BikeStores&encrypt=disable
# Override SA password: MSSQL_SA_PASSWORD=YourStrong@Passw0rd docker compose up -d test-sqlserver sqlserver-init

# Query Settings
BI_QUERY_TIMEOUT_SECONDS=30
BI_QUERY_MAX_ROWS=10000
BI_QUERY_MAX_RUNTIME_SECONDS=60

# Security - base64-encoded 32-byte AES key for DSN encryption (openssl rand -base64 32)
BI_ENCRYPTION_KEY=change-this-to-a-secure-32-byte-key!!

# AI Provider (OpenAI compatible) — used by metadata describe / translation
# and as the default fallback. Pick a model that handles wide-but-shallow
# work well (table & column description generation). The NL→LogicalQuery
# path can be split off below to use a smarter reasoning model.
BI_AI_PROVIDER=openai
BI_AI_API_KEY=
BI_AI_BASE_URL=
BI_AI_MODEL=gpt-4o
BI_AI_MAX_TOKENS=4096
BI_AI_TEMPERATURE=0.0
BI_AI_TOP_P=
BI_AI_NUM_CTX=
BI_AI_HTTP_TIMEOUT_SECONDS=300
BI_AI_RATE_LIMIT_PER_MINUTE=20
# Cap NL→query prompt size (runes ≈ characters for Latin text; lower if provider returns context-length errors)
BI_AI_MAX_PROMPT_RUNES=80000
# AI Describe: truncate each sampled cell; max rows sent to the LLM
BI_AI_DESCRIBE_MAX_CELL_RUNES=500
BI_AI_DESCRIBE_MAX_SAMPLE_ROWS=12

# AI Query model — used ONLY by the NL→LogicalQuery path (/api/ai/query*).
# Every BI_AI_QUERY_* field is OPTIONAL and falls back to BI_AI_* when empty.
# Common setup (same host, smarter model): set ONLY BI_AI_QUERY_MODEL and
# leave provider/base_url/api_key blank so they inherit from the base.
# Use the full set when pointing at a different endpoint entirely.
#BI_AI_QUERY_MODEL=qwen2.5-coder:7b-instruct-q5_K_M
#BI_AI_QUERY_PROVIDER=
#BI_AI_QUERY_BASE_URL=
#BI_AI_QUERY_API_KEY=
#BI_AI_QUERY_HTTP_TIMEOUT_SECONDS=
# Optional: Translate/normalize AI-generated metadata descriptions after Describe.
# Use an OpenAI-compatible endpoint such as Ollama /v1 with TranslateGemma.
# Leave BI_AI_TRANSLATION_MODEL empty to disable this layer.
#BI_AI_TRANSLATION_MODEL=translategemma:4b
#BI_AI_TRANSLATION_BASE_URL=http://localhost:11434/v1
#BI_AI_TRANSLATION_API_KEY=
BI_AI_TRANSLATION_TARGET_LANGUAGE=Turkish
BI_AI_TRANSLATION_TARGET_CODE=tr
BI_AI_TRANSLATION_HTTP_TIMEOUT_SECONDS=120
# Vector embeddings for table routing (optional). Leave BI_AI_EMBEDDING_MODEL
# empty to disable embeddings (keyword-only routing). When set, use
# BI_AI_EMBEDDING_BASE_URL / BI_AI_EMBEDDING_API_KEY for a different host than
# the chat model; if unset, embeddings fall back to BI_AI_BASE_URL / BI_AI_API_KEY.
#BI_AI_EMBEDDING_MODEL=text-embedding-3-small
#BI_AI_EMBEDDING_BASE_URL=
#BI_AI_EMBEDDING_API_KEY=
BI_AI_EMBEDDING_HTTP_TIMEOUT_SECONDS=600
BI_AI_EMBEDDING_WEIGHT=30
# Self-consistency voting (>1 draws N candidates with stepped temperatures).
BI_AI_MULTI_CANDIDATE_COUNT=1
# Auto table-routing prompt caps (0 = use built-in defaults: 56 dims, 32 metrics, 14 cols/table).
BI_AI_ROUTE_MAX_DIMENSIONS=56
BI_AI_ROUTE_MAX_METRICS=32
BI_AI_ROUTE_MAX_COLUMNS_PER_TABLE=14
BI_AI_ROUTE_MAX_DATE_GRAIN_EXTRAS=20
BI_AI_ROUTE_SLIM_NUMERIC_METRICS=true

# Security - Admin API key (required for eval/regression endpoints)
BI_ADMIN_API_KEY=change-this-to-a-secure-admin-api-key

# Frontend - Admin API key (for eval history & regression UI)
VITE_BI_ADMIN_API_KEY=change-this-to-a-secure-admin-api-key
