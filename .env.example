# BI Query Engine Environment Variables
# Copy to .env and modify as needed.
# Parity with deploy/helm/biqly/values*.yaml — local/docker-compose defaults below.

# HTTP Server
BI_HTTP_HOST=0.0.0.0
BI_HTTP_PORT=8888

# Logging (values-dev: debug/text; prod: info/json)
BI_LOG_LEVEL=debug
BI_LOG_FORMAT=text

# Metadata Database (PostgreSQL) — docker compose service: metadata-db
# Host-native runs (make run outside compose): use localhost:5432 instead of metadata-db:5432
BI_METADATA_DB_DSN=postgres://bi_user:bi_password@metadata-db:5432/bi_metadata?sslmode=disable

# Redis (for caching) — docker compose service: redis
BI_REDIS_DSN=redis://redis:6379

# Optional external SQL Server for integration tests (not started by docker compose)
# BI_TEST_SQLSERVER_DSN=sqlserver://sa:password@host:1433?database=test

# Query Settings
BI_QUERY_TIMEOUT_SECONDS=30
BI_QUERY_MAX_ROWS=10000
BI_QUERY_MAX_RUNTIME_SECONDS=60

# Security - base64-encoded 32-byte AES key for DSN encryption (openssl rand -base64 32)
# Base64-encoded 32-byte key (AES-256-GCM). Generate: ./scripts/generate-auth-secrets.sh
BI_ENCRYPTION_KEY=change-this-to-a-secure-32-byte-key!!
BI_INTERNAL_API_TOKEN=dev-internal-token

# Monolith ↔ auth service (global.config in Helm)
BI_AUTH_ENABLED=true
BI_AUTH_SERVICE_URL=http://auth:8889
BI_AUTH_INTERNAL_TOKEN=dev-internal-token

# PII detection & role-based masking (see docs/pii-detection-masking.md)
BI_PII_ENABLED=true
BI_PII_DETECTION_THRESHOLD=0.6
BI_PII_SAMPLE_DATA_LIMIT=50
BI_PII_AUTO_SCAN_ON_SYNC=true
BI_PII_DEFAULT_MASKING_STRATEGY=partial

# Microservice URLs (empty for monolith/docker-compose api; set when splitting services)
# BI_CATALOG_SERVICE_URL=http://localhost:8080
# BI_QUERY_SERVICE_URL=http://localhost:8081

# NATS async AI jobs (docker compose: nats service on 4222)
BI_NATS_URL=nats://nats:4222
BI_AI_JOBS_ENABLED=true

# Auth service (cmd/auth). Run ./scripts/generate-auth-secrets.sh and copy into .env
BI_AUTH_PORT=8889
BI_AUTH_DB_DSN=postgres://bi_auth_user:bi_auth_password@auth-db:5432/bi_auth?sslmode=disable
BI_AUTH_REDIS_DSN=redis://redis:6379
BI_AUTH_ENCRYPTION_KEY=change-this-to-a-secure-32-byte-key!!
BI_AUTH_RATE_LIMIT_PER_MINUTE=60
BI_AUTH_JWT_ACCESS_TTL=15m
BI_AUTH_JWT_REFRESH_TTL=168h
BI_AUTH_WEBAUTHN_RP_ID=localhost
BI_AUTH_WEBAUTHN_RP_NAME=Biqly
BI_AUTH_WEBAUTHN_RP_ORIGINS=http://localhost:5173,http://localhost:3333
BI_AUTH_FRONTEND_BASE_URL=http://localhost:3333
BI_AUTH_GITHUB_REDIRECT_URL=http://localhost:8889/api/auth/oauth/github/callback
BI_AUTH_GOOGLE_REDIRECT_URL=http://localhost:8889/api/auth/oauth/google/callback
BI_AUTH_MAIL_SERVICE_URL=http://mail:8890
BI_AUTH_MAIL_INTERNAL_TOKEN=dev-internal-token
# BI_AUTH_JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
# Or inline PEM for sync-env-to-k8s.sh: BI_AUTH_JWT_PRIVATE_KEY="$(cat ./secrets/jwt-private.pem)"
# BI_AUTH_GITHUB_CLIENT_ID=
# BI_AUTH_GITHUB_CLIENT_SECRET=
# BI_AUTH_GOOGLE_CLIENT_ID=
# BI_AUTH_GOOGLE_CLIENT_SECRET=

# Mail service (cmd/mail)
BI_MAIL_PORT=8890
BI_MAIL_DB_DSN=postgres://bi_mail_user:bi_mail_password@mail-db:5432/bi_mail?sslmode=disable
BI_MAIL_REDIS_DSN=redis://redis:6379
BI_MAIL_INTERNAL_TOKEN=dev-internal-token
BI_MAIL_FRONTEND_BASE_URL=http://localhost:3333
BI_MAIL_EMAIL_DEFAULT_LOCALE=en
BI_MAIL_EMAIL_DAILY_LIMIT=10
BI_MAIL_EMAIL_QUEUE_SIZE=256
BI_MAIL_EMAIL_RETRIES=3
# BI_MAIL_SMTP_HOST=smtp.example.com
# BI_MAIL_SMTP_PORT=587
# BI_MAIL_SMTP_FROM=no-reply@example.com
# BI_MAIL_SMTP_SENDER_NAME=Biqly
# BI_MAIL_SMTP_USER=
# BI_MAIL_SMTP_PASS=

# GitOps — fine-grained GitHub PAT for Argo CD Image Updater (biqly/biqly Contents: write).
# Set via ./deploy/argocd/setup-github-pat.sh (stored in .env.local, not committed).
# BIQLY_GITHUB_TOKEN=github_pat_...
# BIQLY_GITHUB_USER=x-access-token

# AI providers and models (provider type, model ids, base URLs, API keys and
# per-model tuning such as temperature/max_tokens/num_ctx) are NOT configured
# here. They are managed at runtime in the database via the admin UI
# (Administration → AI Providers) and stored in the ai_providers / ai_models
# tables (API keys encrypted with BI_ENCRYPTION_KEY). The variables below are
# operational knobs only.
#
# Operational request budget used to size the HTTP server write timeout. The
# per-provider LLM timeout is configured per provider row in the database.
BI_AI_HTTP_TIMEOUT_SECONDS=300
BI_AI_RATE_LIMIT_PER_MINUTE=20
BI_AI_MAX_RETRIES=1
# Cap NL→query prompt size (runes ≈ characters for Latin text; lower if provider returns context-length errors)
BI_AI_MAX_PROMPT_RUNES=80000
# AI Describe: truncate each sampled cell; max rows sent to the LLM
BI_AI_DESCRIBE_MAX_CELL_RUNES=500
BI_AI_DESCRIBE_MAX_SAMPLE_ROWS=12

# Translation layer behaviour (target language is operational; the translation
# MODEL is selected in the database like every other model).
BI_AI_TRANSLATION_TARGET_LANGUAGE=Turkish
BI_AI_TRANSLATION_TARGET_CODE=tr
BI_AI_TRANSLATION_HTTP_TIMEOUT_SECONDS=120
# Embedding request timeout + routing weight (the embedding MODEL is selected in the database).
BI_AI_EMBEDDING_HTTP_TIMEOUT_SECONDS=600
BI_AI_EMBEDDING_WEIGHT=30
# Self-consistency voting (>1 draws N candidates with stepped temperatures).
BI_AI_MULTI_CANDIDATE_COUNT=1
# Auto table-routing prompt caps (0 = use built-in defaults: 56 dims, 32 metrics, 14 cols/table).
BI_AI_ROUTE_MAX_DIMENSIONS=56
BI_AI_ROUTE_MAX_METRICS=32
BI_AI_ROUTE_MAX_COLUMNS_PER_TABLE=14
BI_AI_ROUTE_MAX_DATE_GRAIN_EXTRAS=20
BI_AI_ROUTE_SLIM_NUMERIC_METRICS=true

# Security - Admin API key (required for eval/regression endpoints)
BI_ADMIN_API_KEY=change-this-to-a-secure-admin-api-key

# Frontend - Admin API key (for eval history & regression UI)
VITE_BI_ADMIN_API_KEY=change-this-to-a-secure-admin-api-key
